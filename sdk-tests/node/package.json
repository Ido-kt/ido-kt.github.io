{
  "name": "accessflow-sdk-node-tests",
  "version": "1.0.0",
  "description": "Node.js integration tests for AccessFlow SDK",
  "private": true,
  "scripts": {
    "test": "npm run test:playwright && npm run test:selenium",
    "test:playwright": "playwright test",
    "test:selenium": "node --test tests/sdk-selenium.spec.js",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@types/node": "^20.11.0",
    "selenium-webdriver": "^4.27.0",
    "typescript": "^5.3.0"
  }
}
