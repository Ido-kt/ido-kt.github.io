<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.acsbe.accessflow</groupId>
    <artifactId>accessflow-sdk-integration-tests</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>AccessFlow SDK Integration Tests - Java</name>
    <description>Integration tests for AccessFlow Java SDK</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <playwright.version>1.42.0</playwright.version>
        <selenium.version>4.27.0</selenium.version>
        <junit.version>5.10.0</junit.version>
        <testng.version>7.9.0</testng.version>
        <!-- Set to true via -DskipTestNG=true on the CLI to skip the TestNG execution
             (used in Selenium-only workflow where Playwright browsers are not installed). -->
        <skipTestNG>false</skipTestNG>
    </properties>

    <!-- GCP Artifact Registry repository (configured in settings.xml for registry install job) -->

    <dependencies>
        <!-- AccessFlow SDK -->
        <!-- This dependency is installed dynamically in CI via:
             - Local install: mvn install:install-file (uses ../packages/*.jar)
             - Registry install: Uses GCP Artifact Registry via repository above
        -->
        <dependency>
            <groupId>com.acsbe</groupId>
            <artifactId>accessflow-sdk</artifactId>
            <version>1.0.1-dev-80604</version>
            <scope>test</scope>
        </dependency>

        <!-- Playwright -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Selenium (for SDKSeleniumTest) -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- TestNG -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0</version>
                <!-- Default execution is disabled; explicit executions below handle each provider. -->
                <configuration>
                    <skip>true</skip>
                </configuration>
                <executions>
                    <!-- JUnit 5 tests (SDKAuditTest, SDKSeleniumTest) -->
                    <execution>
                        <id>junit5</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skip>false</skip>
                            <excludes>
                                <exclude>**/SDKTestNGTest.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>

                    <!-- TestNG tests (SDKTestNGTest via testng.xml).
                         Pass -DskipTestNG=true on the command line to skip this execution
                         (e.g. in the Selenium-only workflow where Playwright is not installed). -->
                    <execution>
                        <id>testng</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skip>${skipTestNG}</skip>
                            <suiteXmlFiles>
                                <suiteXmlFile>testng.xml</suiteXmlFile>
                            </suiteXmlFiles>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
