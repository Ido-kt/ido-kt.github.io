  # ============================================================================
  # Java Tests - Local Install
  # ============================================================================
  java-local:
    name: Java (Local Package)
    runs-on: ubuntu-22.04

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          java-version: '11'
          distribution: 'temurin'

      - name: Install SDK to local Maven repository
        working-directory: ./sdk-tests/java
        run: |
          echo "📦 Installing SDK JAR to local Maven repository..."
          JAR_FILE="../packages/accessflow-sdk.jar"
          if [ ! -f "$JAR_FILE" ]; then
            echo "❌ Error: JAR file not found at $JAR_FILE"
            ls -la ../packages/
            exit 1
          fi
          mvn install:install-file \
            -Dfile="$JAR_FILE" \
            -DgroupId=com.acsbe \
            -DartifactId=accessflow-sdk \
            -Dversion=1.0.1-dev-80604 \
            -Dpackaging=jar \
            -DgeneratePom=true
          echo "✅ SDK installed to local Maven repository"

      - name: Resolve Maven dependencies
        working-directory: ./sdk-tests/java
        run: mvn dependency:resolve

      - name: Install Playwright browsers
        working-directory: ./sdk-tests/java
        run: mvn exec:java -e -D exec.mainClass=com.microsoft.playwright.CLI -D exec.classpathScope=test -D exec.args="install --with-deps chromium"

      - name: Create test-results directory
        run: mkdir -p test-results
        working-directory: ./sdk-tests/java

      - name: Run tests
        working-directory: ./sdk-tests/java
        env:
          ACCESSFLOW_SDK_API_KEY: ${{ secrets.ACCESSFLOW_SDK_API_KEY }}
          CI: true
        # Playwright only: do not run SDKSeleniumTest
        run: mvn test -Dtest=SDKAuditTest

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: java-local-results
          path: |
            sdk-tests/java/test-results/
            sdk-tests/java/target/surefire-reports/
          retention-days: 7

