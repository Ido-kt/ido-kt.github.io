/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SDK integration tests
/sdk-tests/node/node_modules/
/sdk-tests/node/test-results/
/sdk-tests/node/playwright-report/
/sdk-tests/node/.npmrc
/sdk-tests/node/package-lock.json

/sdk-tests/python/test-results/
/sdk-tests/python/reports/
